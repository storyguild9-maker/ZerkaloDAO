# Public application URL. Use the final HTTPS address after deployment.
NEXT_PUBLIC_APP_URL=https://example.com
NEXT_PUBLIC_ASSET_BASE_URL=https://assets.example.com

# Telegram bot
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_BOT_TOKEN=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600
# Separate random secret used only to make stored Telegram subjects irreversible.
TELEGRAM_SESSION_SECRET=
# Optional comma/space-separated Telegram user IDs. When set, only these users
# can authenticate and receive the personalized Mini App menu button.
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_MENU_BUTTON_TEXT=Открыть Зеркало

# Local testing outside Telegram. Keep both values false in production.
NEXT_PUBLIC_TELEGRAM_DEV_MODE=false
TELEGRAM_ALLOW_DEV_AUTH=false

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Cloudflare R2 asset storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=zerkalo-dao
