# Public application URL. Use the final HTTPS address after deployment.
NEXT_PUBLIC_APP_URL=https://example.com
NEXT_PUBLIC_ASSET_BASE_URL=https://assets.example.com

# Telegram bot
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_BOT_TOKEN=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600
# Separate random secret used only to make stored Telegram subjects irreversible.
TELEGRAM_SESSION_SECRET=
# Optional comma/space-separated Telegram user IDs. When set, only these users
# can authenticate and receive the personalized Mini App menu button.
TELEGRAM_ALLOWED_USER_IDS=
# Optional governance administrators. Defaults to TELEGRAM_ALLOWED_USER_IDS.
TELEGRAM_GOVERNANCE_ADMIN_IDS=
# Host returned by TON Connect signData, without scheme.
TON_SIGN_DATA_DOMAIN=example.com
TELEGRAM_MENU_BUTTON_TEXT=Открыть Зеркало

# Local testing outside Telegram. Keep both values false in production.
NEXT_PUBLIC_TELEGRAM_DEV_MODE=false
TELEGRAM_ALLOW_DEV_AUTH=false

# TON Testnet-only automatic 100 GRAM grant. Never reuse the authorizer seed
# for a wallet or for mainnet. Store it only in server-side secret storage.
TON_TESTNET_DISTRIBUTOR_ADDRESS=
TON_TESTNET_DISTRIBUTOR_AUTHORIZER_SEED=
TON_TESTNET_API_ENDPOINT=https://testnet.toncenter.com/api/v2/jsonRPC
TON_TESTNET_API_KEY=
# Deployment helper values, denominated in test GRAM. One participant requires
# 100 GRAM in the distributor in addition to its immutable reserve and fees.
TON_TESTNET_DISTRIBUTOR_DEPLOY_VALUE=0.2
TON_TESTNET_DISTRIBUTOR_TOP_UP=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Cloudflare R2 asset storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=zerkalo-dao
